<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para el amor de mi vida</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            background: linear-gradient(135deg, #120007 0%, #3d0016 50%, #6e0025 100%);
            font-family: 'Segoe UI', Roboto, sans-serif;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            perspective: 1000px;
        }
        
        /* Carta Central */
        .carta {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            padding: 35px 25px;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(255, 77, 115, 0.2);
            text-align: center;
            max-width: 85%;
            width: 360px;
            z-index: 10;
            animation: aparecer Carta 1.5s ease-out;
            border: 2px solid rgba(255, 182, 193, 0.5);
        }

        h1 {
            color: #d60042;
            font-size: 2.2rem;
            margin: 0 0 15px 0;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
        }

        p {
            color: #4a0018;
            font-size: 1.1rem;
            line-height: 1.6;
            margin: 0;
            font-weight: 500;
        }

        /* Corazones de fondo infinitos */
        .decoracion-corazon {
            position: absolute;
            color: rgba(255, 51, 102, 0.4);
            pointer-events: none;
            z-index: 1;
            animation: flotarContinuo linear infinite;
        }

        /* Explosiones por toque */
        .particula {
            position: absolute;
            pointer-events: none;
            z-index: 5;
            animation: explosion 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
            font-size: 2rem;
        }

        @keyframes aparecerCarta {
            0% { opacity: 0; transform: scale(0.7) translateY(50px) rotateX(-30deg); }
            100% { opacity: 1; transform: scale(1) translateY(0) rotateX(0); }
        }

        @keyframes flotarContinuo {
            0% { transform: translateY(105vh) scale(0.5) rotate(0deg); opacity: 0; }
            10% { opacity: 0.7; }
            90% { opacity: 0.7; }
            100% { transform: translateY(-15vh) scale(1.5) rotate(360deg); opacity: 0; }
        }

        @keyframes explosion {
            0% { transform: translate(0, 0) scale(1); opacity: 1; }
            100% { transform: translate(var(--x), var(--y)) scale(0.3) rotate(var(--r)); opacity: 0; }
        }
    </style>
</head>
<body>

    <div class="carta">
        <h1>Te amo ❤️</h1>
        <p>Eres la persona que ilumina mis días, mi lugar seguro y mi motivo para sonreír. Gracias por ser mi novia y por hacer mi mundo tan bonito. ✨</p>
    </div>

    <script>
        // 1. Generador automático de fondo intenso
        const modelosCorazones = ['❤️', '💖', '💝', '💕', '✨'];
        
        function crearCorazonDeFondo() {
            const c = document.createElement('div');
            c.classList.add('decoracion-corazon');
            c.innerHTML = modelosCorazones[Math.floor(Math.random() * modelosCorazones.length)];
            
            c.style.left = Math.random() * 100 + 'vw';
            const duracion = Math.random() * 4 + 4; // Entre 4 y 8 segundos
            c.style.animationDuration = duracion + 's';
            c.style.fontSize = Math.random() * 1.5 + 0.8 + 'rem';
            
            document.body.appendChild(c);
            setTimeout(() => { c.remove(); }, duracion * 1000);
        }

        // Crea un corazón cada 250ms automáticamente
        setInterval(crearCorazonDeFondo, 250);

        // 2. Explosión masiva al tocar la pantalla
        function estallar(clientX, clientY) {
            const cantidad = 15; // Número de corazones por toque
            for (let i = 0; i < cantidad; i++) {
                const p = document.createElement('div');
                p.classList.add('particula');
                p.innerHTML = modelosCorazones[Math.floor(Math.random() * modelosCorazones.length)];
                
                p.style.left = clientX - 15 + 'px';
                p.style.top = clientY - 15 + 'px';
                
                // Direcciones aleatorias para la explosión
                const angulo = Math.random() * Math.PI * 2;
                const distancia = Math.random() * 150 + 50;
                const x = Math.cos(angulo) * distancia;
                const y = Math.sin(angulo) * distancia;
                const rotacion = Math.random() * 360;
                
                p.style.setProperty('--x', `${x}px`);
                p.style.setProperty('--y', `${y}px`);
                p.style.setProperty('--r', `${rotacion}deg`);
                
                document.body.appendChild(p);
                setTimeout(() => { p.remove(); }, 1200);
            }
        }

        // Detectar toques en móvil y click en PC
        document.addEventListener('click', (e) => {
            if(!e.target.closest('.carta')) estallar(e.clientX, e.clientY);
        });
        
        document.addEventListener('touchstart', (e) => {
            if(!e.target.closest('.carta')) {
                estallar(e.touches[0].clientX, e.touches[0].clientY);
            }
        });
    </script>
</body>
</html>
